# Copie para .env.local e preencha. Nunca commite o .env.local (RNF-19).
# Caracteres especiais da senha precisam ir codificados na URL (% vira %25, @ vira %40).

# Banco da aplicação. Local em dev; na Vercel, a URL do Neon (definida no painel, não aqui).
DATABASE_URL=postgresql://postgres:<senha>@localhost:5432/tcc

# Banco descartável da suíte test:db. Precisa ser localhost e terminar em _test:
# a suíte apaga e recria este banco a cada execução.
TEST_DATABASE_URL=postgresql://postgres:<senha>@localhost:5432/tcc_test

# Chave do OpenRouteService (openrouteservice.org), para sugerir a rota da viagem de
# entrega (P14). Só no servidor. Sem ela, a rota continua funcionando, ordenada à mão.
ORS_API_KEY=

# Aviso no celular (Web Push) quando o pedido muda de mão. Gere o par com
# `npx web-push generate-vapid-keys`. A pública vai ao navegador; a privada só no servidor.
# Sem elas o sistema funciona igual, só sem o aviso.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável, exigido pelo serviço de push
VAPID_SUBJECT=mailto:
