%% Modulo 1 de 4. Cliente, fornecedor e funcionario sao PAPEIS de uma pessoa:
%% a porta de entrada e /cadastros/pessoas, nao uma aba por papel.
%% Modulo 1 de 4. Regra de corte: e cadastro se, ao apaga-lo, um movimento
%% passado ficar sem sentido. Custos fixos foi para o Financeiro (valor que
%% muda todo mes, alimentado pelo extrato) e coleta de sementes para a
%% Producao (atividade de campo) — nenhum dos dois passa nessa regra.
flowchart TB
  subgraph PRODU["Cadastros de produto"]
    direction LR
    ESP["<b>Espécies</b><br/>nome popular · nome científico · sinônimos<br/>características · fotografia<br/>cadastro rápido · revisão de incompletos"]
    REC["<b>Recipientes</b><br/>tubete · sacos 10x18 a 28x32 · balde<br/>definem o tamanho da muda"]
    INS["<b>Insumos</b><br/>nome · unidade de medida<br/><i>o tipo; a compra nasce no Financeiro</i>"]
    ESP ~~~ REC ~~~ INS
  end

  subgraph PESSOAS["Pessoas &nbsp;&mdash;&nbsp; UMA lista, filtrada por papel"]
    direction LR
    CLI["<b>Cliente</b><br/>pessoa física e jurídica<br/>consulta automática por CNPJ<br/>dados fiscais para nota<br/>cadastro rápido dentro do pedido"]
    FOR["<b>Fornecedor</b><br/>contato · cidade e estado<br/>espécies que fornece<br/>coordenadas por geocodificação"]
    FUN["<b>Funcionário</b><br/>existe sem login<br/>vínculo fixo ou diarista<br/><i>filtro já existe; tela não</i>"]
    CLI ~~~ FOR ~~~ FUN
  end

  IDE["<b>Identidade única</b> &mdash; <code>cadastro.parties</code><br/>quem vende muda e às vezes compra é <b>um cadastro só</b><br/>a lista mostra a pessoa uma vez, com um selo por papel<br/>o financeiro aponta para a mesma pessoa em toda linha do extrato"]

  subgraph OPER["Cadastros de operação"]
    direction LR
    TIP["<b>Tipos de tarefa</b><br/>vocabulário da agenda de produção<br/>tempo médio por unidade &rarr; custeio"]
    ARE["<b>Áreas e canteiros</b><br/>letra da área · número do canteiro<br/>o par é o <b>endereço da muda</b>"]
    TUR["<b>Período de trabalho</b><br/>hora de início e de fim de cada turno<br/>é dele que sai a duração do turno"]
    CCU["<b>Centros de custo</b><br/>negócio ou pessoal &mdash; separa os dois<br/>inativa, nunca exclui<br/><i>tabela no schema financeiro; só chefia vê</i>"]
    TIP ~~~ ARE ~~~ TUR ~~~ CCU
  end

  subgraph CONS["Para onde os cadastros vão &nbsp;&mdash;&nbsp; os outros três módulos"]
    direction LR
    D2["<b>2 · Produção</b><br/>espécie · recipiente · insumo<br/>funcionário · tipo de tarefa<br/>área e canteiro · turno"]
    D3["<b>3 · Comercial</b><br/>cliente e espécie no pedido<br/>fornecedor na cotação"]
    D4["<b>4 · Financeiro</b><br/>contraparte e centro de custo do lançamento<br/>espécie e recipiente no custeio"]
    D2 ~~~ D3 ~~~ D4
  end

  INS ~~~ CLI
  FUN ~~~ TIP

  CLI --> IDE
  FOR --> IDE
  FUN --> IDE

  ESP --> D2
  REC --> D2
  INS --> D2
  TIP --> D2
  ARE --> D2
  TUR --> D2
  CCU --> D4
  ESP --> D3
  IDE --> D3
  ESP --> D4
  REC --> D4
  IDE --> D4

  subgraph LEG["Legenda"]
    direction LR
    L1["implementado no protótipo"]
    L2["parcialmente implementado"]
    L3["especificado, não implementado"]
    L1 ~~~ L2 ~~~ L3
  end
  CONS ~~~ LEG

  %% Paleta de STATUS — a fonte e colorida de proposito; o PNG sai em cinza.
  %% Quem troca a cor pelo cinza e `npm run docs:mapas` (scripts/render-mapas.mjs).
  %% Criterio: ok = toda etapa do modulo tem tela · meio = parte tem · falta = nenhuma tem.
  classDef ok fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#111
  classDef meio fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#111
  classDef falta fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#111
  classDef grupo fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#334155
  classDef ator fill:#374151,stroke:#111827,stroke-width:2px,color:#f9fafb
  classDef decisao fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#111

  %% Telas que existem hoje.
  class ESP,REC,INS,CLI,FOR,IDE,L1 ok
  %% Os outros tres modulos: todos comecados, nenhum completo.
  class D2,D3,D4,L2 meio
  %% Sem tela: funcionario (P13 T13.7), tipo de tarefa (P13 T13.8), area e
  %% canteiro e periodo de trabalho (P14, tabelas ja no banco desde 24/08/2026)
  %% e centro de custo (P13 T13.24 a T13.26).
  class FUN,TIP,ARE,TUR,CCU,L3 falta
  class PRODU,PESSOAS,OPER,CONS,LEG grupo

