flowchart TB
  USR(["Usuário<br/>chefia · gerência · colaborador · administrador"])

  LOG["<b>Login</b><br/>usuário e senha<br/>senha armazenada com salt (scrypt)"]
  DEC{"Primeiro acesso ou<br/>senha provisória?"}
  SEN["<b>Definir senha</b><br/>política mínima de complexidade<br/>obrigatória antes de seguir"]
  SES["<b>Sessão</b><br/>cookie assinado · validade de 90 dias<br/>registra aparelho e endereço de origem"]
  PAI["<b>Painel inicial</b><br/>exibe apenas os atalhos permitidos ao perfil"]

  subgraph OPE["Telas de conta"]
    direction LR
    TRO["<b>Trocar senha</b><br/>a qualquer momento"]
    APA["<b>Aparelhos conectados</b><br/>lista as sessões ativas<br/>encerra sessão remotamente"]
    SAI["<b>Sair</b><br/>encerra a sessão do aparelho"]
    TRO ~~~ APA ~~~ SAI
  end

  NOT["<b>Notificações</b><br/>sino no cabeçalho e tela própria<br/>encadeiam as etapas do pedido"]

  subgraph AUT["Autorização &mdash; verificada em toda operação"]
    direction LR
    USUA["<b>Usuários e permissões</b><br/>criar conta · atribuir perfil<br/>redefinir senha provisória"]
    MAT["<b>Matriz de permissões</b><br/>4 perfis &times; recurso &times; verbo<br/>criar · ler · atualizar · excluir"]
    GUA["<b>Guarda por operação</b><br/>acesso direto ao endereço<br/>também é barrado"]
    USUA --> MAT --> GUA
  end

  MOD["<b>Módulos do sistema</b><br/>cadastros · produção · comercial · financeiro"]

  USR --> LOG
  LOG --> DEC
  DEC -->|sim| SEN
  SEN --> SES
  DEC -->|não| SES
  SES --> PAI
  PAI --> MOD
  PAI --> NOT
  PAI --> OPE
  MAT -.->|filtra os atalhos| PAI
  GUA -.->|autoriza ou devolve| MOD

  subgraph LEG["Legenda"]
    direction LR
    L1["implementado no protótipo"]
    L2["parcialmente implementado"]
    L3["especificado, não implementado"]
    L1 ~~~ L2 ~~~ L3
  end
  MOD ~~~ LEG

  %% Paleta de STATUS — a fonte e colorida de proposito; o PNG sai em cinza.
  %% Quem troca a cor pelo cinza e `npm run docs:mapas` (scripts/render-mapas.mjs).
  %% Criterio: ok = toda etapa do modulo tem tela · meio = parte tem · falta = nenhuma tem.
  classDef ok fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#111
  classDef meio fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#111
  classDef falta fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#111
  classDef grupo fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#334155
  classDef ator fill:#374151,stroke:#111827,stroke-width:2px,color:#f9fafb
  classDef decisao fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#111

  class LOG,SEN,SES,PAI,TRO,APA,SAI,NOT,USUA,MAT,GUA,MOD,L1 ok
  class L2 meio
  class L3 falta
  class USR ator
  class DEC decisao
  class OPE,AUT,LEG grupo

