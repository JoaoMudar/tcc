%% Producao: o trabalho da semana e a muda no canteiro.
flowchart LR
  AG["agenda da semana<br/><small>rascunho → publicada → fechada</small>"]
  CF["confirmar tarefa<br/><small>quantidade por participante</small>"]
  LO["lotes<br/><small>espécie, recipiente, canteiro</small>"]
  MV["movimentos do lote<br/><small>perda, repicagem, venda, ajuste</small>"]
  PL["protocolo do lote<br/><small>etapas e vencimentos</small>"]
  MA["mapa de lotes<br/><small>atraso, mortalidade, ocupação</small>"]

  AG --> CF
  CF --> MV
  LO --> MV
  LO --> PL
  PL -->|"gera ordem"| AG
  MV --> MA
  AG --> MA

  classDef ok fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#111
  classDef meio fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#111
  classDef falta fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#111
  classDef grupo fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#334155

  class AG,CF,LO,MV,PL,MA falta
