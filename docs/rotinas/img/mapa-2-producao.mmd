%% Modulo 2 de 4. Estoque fica aqui (e derivado da producao, nao cadastro).
%% Custeio e precificacao sairam para o Financeiro: sao dinheiro, e quem os
%% alimenta e o extrato bancario. A entrada de compras vem de la.
flowchart TB
  CAD["<b>1 · Cadastros</b><br/>espécies · recipientes · insumos<br/>funcionários · tipos de tarefa<br/>áreas · canteiros · turnos"]
  FIN["<b>4 · Financeiro</b><br/>a compra do insumo nasce lá<br/>e fica disponível para uso aqui"]

  subgraph CAMPO["Registro em campo &mdash; colaborador, no celular"]
    direction LR
    CON["<b>Consumo de insumos</b><br/>insumo · espécie · recipiente · quantidade · data<br/>funciona sem conexão, sincroniza depois"]
    ATV["<b>Apontamento de tarefas</b><br/>início e fim por funcionário<br/>quantidade por participante quando a tarefa é quantitativa"]
    COL["<b>Coleta de sementes</b><br/>origem própria da matéria-prima"]
    PER["<b>Perdas</b><br/>lote · quantidade · causa"]
    CON ~~~ ATV ~~~ COL ~~~ PER
  end

  AGE["<b>Agenda de pessoal</b><br/>quem faz o quê na semana<br/>grupo de funcionários por tarefa"]
  LOT["<b>Lotes e canteiros</b><br/>área · canteiro · espécie · recipiente · saldo<br/>repicagem cria lote filho ligado à origem"]
  EST["<b>Estoque</b><br/><i>produção &minus; perdas &minus; vendas</i><br/>contagem periódica de conferência"]

  subgraph ALE["Alertas"]
    direction LR
    A1["<b>Mortalidade</b><br/>acima de 20% por espécie"]
    A2["<b>Estoque baixo</b><br/>abaixo do mínimo ou zerado"]
    A1 ~~~ A2
  end

  COM["<b>3 · Comercial</b><br/>disponibilidade na verificação do pedido"]
  CUS["<b>4 · Financeiro &mdash; custeio</b><br/>consumo + horas &times; valor-hora + gasto extra<br/>é o que transforma campo em custo por muda"]

  CAD ==> CON
  CAD --> ATV
  CAD --> COL
  CAD ==> AGE
  FIN ==>|"compra disponível para uso"| CON
  AGE --> ATV
  ATV --> LOT
  ATV --> PER
  LOT --> PER
  LOT --> EST
  PER --> EST
  CON ==> CUS
  ATV ==>|"horas &times; valor-hora"| CUS
  AGE -.->|"turno, onde não houve apontamento"| CUS
  PER --> A1
  EST --> A2
  EST --> COM

  subgraph LEG["Legenda"]
    direction LR
    L1["implementado no protótipo"]
    L2["parcialmente implementado"]
    L3["especificado, não implementado"]
    L1 ~~~ L2 ~~~ L3
  end
  COM ~~~ LEG

  %% Paleta de STATUS — a fonte e colorida de proposito; o PNG sai em cinza.
  %% Quem troca a cor pelo cinza e `npm run docs:mapas` (scripts/render-mapas.mjs).
  %% Criterio: ok = toda etapa do modulo tem tela · meio = parte tem · falta = nenhuma tem.
  classDef ok fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#111
  classDef meio fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#111
  classDef falta fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#111
  classDef grupo fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#334155
  classDef ator fill:#374151,stroke:#111827,stroke-width:2px,color:#f9fafb
  classDef decisao fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#111

  %% Nenhuma das treze etapas do modulo tem tela: as duas telas avulsas do P1
  %% (consumo de insumo e coleta de sementes) sairam em 26/08/2026. A coleta
  %% passa a ser atividade da agenda e o consumo entra pelo apontamento (P14).
  class L1 ok
  class CAD,FIN,COM,L2 meio
  class CON,COL,ATV,PER,AGE,LOT,EST,A1,A2,CUS,L3 falta
  class CAMPO,ALE,LEG grupo

