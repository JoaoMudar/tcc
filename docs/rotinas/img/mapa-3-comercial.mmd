%% Comercial: o pedido negociado fora do sistema, registrado dentro dele.
flowchart LR
  CR["cadastrar pedido<br/><small>cliente, canal, itens</small>"]
  PC["informar preço<br/><small>digitado por item</small>"]
  SD["consultar saldo<br/><small>muda pronta da produção</small>"]
  CO["confirmar pedido<br/><small>trava os itens</small>"]
  AC["acompanhar pedidos"]

  CR --> PC
  CR --> SD
  PC --> CO
  CO --> AC

  classDef ok fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#111
  classDef meio fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#111
  classDef falta fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#111
  classDef grupo fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#334155

  class CR,SD,AC ok
  class PC,CO meio
