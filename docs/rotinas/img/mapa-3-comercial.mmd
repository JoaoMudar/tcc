%% Modulo 3 de 4. O CADASTRO do fornecedor e do modulo 1; aqui fica a
%% cotacao, que e movimento. Entregas deixou de ser a 5a etapa do pedido e
%% virou item irmao: uma carga vira viagem, e viagem tem calendario proprio.
flowchart TB
  WPP(["Negociação por WhatsApp<br/>conduzida por pessoa"])

  P1["<b>1 · Cadastro do pedido</b> &mdash; chefia<br/>colagem do texto do WhatsApp<br/>busca preditiva de cliente e espécie<br/>itens específicos e itens genéricos<br/><i>situação: cadastrado</i>"]
  P2["<b>2 · Verificação de disponibilidade</b> &mdash; gerência<br/>lista de conferência no celular<br/>atribuição de espécies aos itens genéricos<br/><i>situação: verificando &rarr; verificado</i>"]
  P3["<b>3 · Análise e aprovação</b> &mdash; chefia<br/>aprovação integral ou parcial<br/>indicação de nota fiscal<br/>devolução para ajuste retorna à etapa 1<br/><i>situação: aprovado ou pendente de alteração</i>"]
  P4["<b>4 · Cargas e separação</b> &mdash; gerência<br/>divisão do pedido em cargas<br/>lista de separação por carga<br/><i>situação: separando &rarr; pronto para envio</i>"]
  ENT["<b>Calendário de entregas</b><br/>cada carga é uma viagem<br/>agenda · roteiro · confirmação"]

  APO["<b>Apoio ao pedido</b><br/>listagem com filtros<br/>detalhamento · edição · cancelamento"]

  CAD["<b>1 · Cadastros</b><br/>cliente e espécie do pedido<br/>fornecedor da cotação"]

  subgraph FORN["Compra externa &mdash; complementa a produção própria"]
    direction LR
    F1["<i>fornecedor vem do cadastro</i><br/>quem é, contato, cidade<br/>e espécies que oferece"]
    F2["<b>Cotação</b><br/>a partir dos itens indisponíveis<br/>ou avulsa · mensagem e link de<br/>WhatsApp, envio manual"]
    F3["<b>Comparação de propostas</b><br/>preço de revenda com margem mínima<br/>propostas abaixo da margem<br/>são sinalizadas"]
    F4["<b>Painel de cotações · Mapa</b><br/>situação das cotações<br/>responsividade · lacunas da rede<br/>distância e frete"]
    F1 --> F2 --> F3 --> F4
  end

  FIN["<b>4 · Financeiro</b><br/>venda · compra de fornecedor · nota fiscal<br/>o preço por canal volta de lá para a aprovação"]

  CAD ==> P1
  CAD ==> F1
  WPP --> P1
  P1 -->|"notifica a gerência"| P2
  P2 -->|"notifica a chefia"| P3
  P3 -->|"notifica a gerência"| P4
  P4 --> ENT
  P1 -.- APO
  P2 -.->|"falta muda"| F2
  F3 -.->|"item comprado entra no pedido"| P3
  P3 ==> FIN
  F3 --> FIN
  ENT --> FIN
  FIN -.->|"preço por canal"| P3

  subgraph LEG["Legenda"]
    direction LR
    L1["implementado no protótipo"]
    L2["parcialmente implementado"]
    L3["especificado, não implementado"]
    L1 ~~~ L2 ~~~ L3
  end
  FIN ~~~ LEG

  %% Paleta de STATUS — a fonte e colorida de proposito; o PNG sai em cinza.
  %% Quem troca a cor pelo cinza e `npm run docs:mapas` (scripts/render-mapas.mjs).
  %% Criterio: ok = toda etapa do modulo tem tela · meio = parte tem · falta = nenhuma tem.
  classDef ok fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#111
  classDef meio fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#111
  classDef falta fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#111
  classDef grupo fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,color:#334155
  classDef ator fill:#374151,stroke:#111827,stroke-width:2px,color:#f9fafb
  classDef decisao fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#111

  %% Seis das oito etapas tem tela: falta so a entrega.
  class P1,P2,P3,P4,F1,F2,F3,F4,APO,L1 ok
  class CAD,FIN,L2 meio
  class ENT,L3 falta
  class WPP ator
  class FORN,LEG grupo

